# Backend routing and live traffic provider
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/route_intelligence?appName=Cluster0&authSource=admin
MONGODB_DATABASE=route_intelligence
JWT_SECRET=
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
AUTH_RATE_LIMIT_ATTEMPTS=8
AUTH_RATE_LIMIT_WINDOW_SECONDS=300
PREMIUM_MONTHLY_PRICE_INR=199
PREMIUM_YEARLY_PRICE_INR=1499
FEATURE_ACCESS_OVERRIDES=

ROUTING_PROVIDER=here
HERE_API_KEY=
HERE_ROUTING_URL=https://router.hereapi.com/v8/routes
HERE_TRAFFIC_URL=https://data.traffic.hereapi.com/v7/flow
HERE_TRAFFIC_CACHE_TTL_SECONDS=30

# Structured route-intent parser. The local parser works without an AI key.
AI_PROVIDER=local
AI_MODEL=gpt-4o-mini
AI_API_KEY=
LLM_PROVIDER=local
OPENAI_API_KEY=
OPENWEATHER_API_KEY=
OCR_SPACE_API_KEY=

# Route stability thresholds
REROUTE_MIN_TIME_SAVING_MINUTES=5
REROUTE_MIN_PERCENT_IMPROVEMENT=10
REROUTE_COOLDOWN_SECONDS=300
GPS_ROUTE_CHECK_INTERVAL_SECONDS=30
ROUTE_MATRIX_MAX_LOCATIONS=10

# Live navigation thresholds
NAVIGATION_LOCATION_UPDATE_SECONDS=1
ROUTE_RECALCULATION_INTERVAL_SECONDS=30
OFF_ROUTE_DISTANCE_METERS=50
ARRIVAL_RADIUS_METERS=30
