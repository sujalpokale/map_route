# ==========================================================
# Route Intelligence Platform - Environment Configuration
# ==========================================================

# Core Application
APP_NAME="Route Intelligence Platform"
APP_ENV=development
API_V1_PREFIX=/api/v1
SECRET_KEY=dev_secret_key_change_in_production_super_secret_jwt_key_98234
ACCESS_TOKEN_EXPIRE_MINUTES=1440
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (PostgreSQL + PostGIS)
# Default is asyncpg for PostgreSQL. Local dev fallback works with sqlite+aiosqlite:///./route_platform.db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/route_intelligence
# Fallback local sqlite for quick testing without Docker:
# DATABASE_URL=sqlite+aiosqlite:///./route_platform.db

POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=route_intelligence
POSTGRES_PORT=5432

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/0

# Routing & Map Providers (osrm | mapbox | google)
# Defaults to public OSRM / OpenStreetMap (Free, zero API key needed!)
ROUTING_PROVIDER=osrm
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org

# Optional Commercial Map Providers (if enabled)
MAPBOX_ACCESS_TOKEN=pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJleGFtcGxlIn0.example
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1IjoiZXhhbXBsZSIsImEiOiJleGFtcGxlIn0.example
NEXT_PUBLIC_CARTO_API_KEY=
GOOGLE_MAPS_API_KEY=

# Weather Provider (open-meteo is 100% free with zero API key needed!)
WEATHER_PROVIDER=open-meteo
OPENWEATHER_API_KEY=

# AI Transportation Assistant (local | openai | anthropic | gemini)
# Default 'local' performs deterministic tool calling and structured reasoning without external API cost
LLM_PROVIDER=local
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
LLM_MODEL=gpt-4o-mini

# OCR & Computer Vision Location Parsing (local | vision_api)
OCR_PROVIDER=local

# Economic & Vehicle Baseline Defaults (INR)
DEFAULT_PETROL_PRICE_INR=105.50
DEFAULT_DIESEL_PRICE_INR=92.50
DEFAULT_EV_KWH_PRICE_INR=12.00
DEFAULT_DRIVER_HOURLY_WAGE_INR=150.00
DEFAULT_MAINTENANCE_PER_KM_INR=2.50

# Web Frontend URL
NEXT_PUBLIC_API_URL=http://localhost:8000
